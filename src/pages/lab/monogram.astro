---
/**
 * Throwaway prototype for the `CW.` monogram hero.
 *
 * Deliberately standalone — it does not use BaseLayout, so it never touches
 * ClientRouter, site.js or the live particle field. Delete this file and
 * src/scene/monogram-*.js to remove the experiment without a trace.
 */
import "../../styles/main.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Lab — CW. monogram</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <canvas class="lab-canvas" id="lab-canvas" aria-hidden="true"></canvas>

    <!-- Scrub control, so any point in the transition can be held and judged. -->
    <div class="lab-hud">
      <label class="mono" for="scrub">progress</label>
      <input id="scrub" type="range" min="0" max="3" step="0.01" value="0" />
      <output class="mono" id="scrub-out">0.00</output>
      <button class="mono" id="scrub-toggle" type="button">scroll</button>
    </div>

    <main class="lab-main">
      <section class="section section--hero" id="hero">
        <div class="hero__meta">
          <span class="mono">Based in Taiwan</span>
          <span class="mono">Lab</span>
        </div>

        <!-- Only shown in the "mark" layout, where the monogram is the hero. -->
        <p class="lab-name mono">Cheng Wei, Wang</p>

        <h1 class="hero__title">
          <span class="line"><span class="line__inner">Cheng Wei,</span></span>
          <span class="line"><span class="line__inner">Wang</span></span>
        </h1>

        <div class="hero__foot">
          <p class="hero__roles mono">
            Front-End<span class="sep">/</span>Back-End<span class="sep">/</span>Web&nbsp;Game
          </p>
        </div>
      </section>

      <section class="section lab-section">
        <p class="section__label mono">(01) — Opening</p>
        <p class="lab-copy">
          The solid comes apart along its own facets and the wireframe underneath
          is what the parting reveals.
        </p>
      </section>

      <section class="section lab-section">
        <p class="section__label mono">(02) — Wireframe</p>
        <p class="lab-copy">
          Every edge belongs to the extrusion that was just standing here. No
          second model, no cross-fade.
        </p>
      </section>

      <section class="section lab-section">
        <p class="section__label mono">(03) — Particles</p>
        <p class="lab-copy">
          Points are seeded on the solid's surface, so they are already in place
          before they scatter to the lattice.
        </p>
      </section>
    </main>

    <style>
      .lab-canvas {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
      }

      .lab-main {
        position: relative;
        z-index: 1;
      }

      .lab-section {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .lab-copy {
        max-width: 34ch;
        margin-top: 1.5rem;
        font-size: clamp(1rem, 2vw, 1.25rem);
        color: var(--fg-dim);
      }

      .lab-hud {
        position: fixed;
        left: 50%;
        bottom: 1.5rem;
        transform: translateX(-50%);
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.7rem 1.1rem;
        border: 1px solid var(--line-soft);
        border-radius: 999px;
        background: rgba(10, 10, 13, 0.82);
        backdrop-filter: blur(12px);
      }

      .lab-hud input {
        width: min(46vw, 26rem);
        accent-color: var(--accent);
      }

      .lab-hud output {
        min-width: 3.2em;
        color: var(--accent);
      }

      .lab-hud button {
        padding: 0.35rem 0.7rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: none;
        color: var(--fg-dim);
        cursor: pointer;
      }

      .lab-hud button[data-mode="manual"] {
        border-color: var(--accent);
        color: var(--accent);
      }

      /*
        Layout B — the monogram carries the hero and the name drops to a
        caption. Tests whether "CW." can be the subject rather than something
        competing with a headline that already says the same thing.
      */
      .lab-name {
        display: none;
        color: var(--fg-dim);
      }

      body[data-layout="mark"] .hero__title {
        display: none;
      }

      body[data-layout="mark"] .lab-name {
        display: block;
        margin-top: auto;
      }
    </style>

    <script>
      import MonogramField from "../../scene/MonogramField.js";

      const canvas = document.getElementById("lab-canvas");
      const scrub = document.getElementById("scrub");
      const out = document.getElementById("scrub-out");
      const toggle = document.getElementById("scrub-toggle");

      const field = new MonogramField(canvas, { quality: "high" });
      let manual = false;

      const show = (value) => {
        field.setProgress(value);
        out.textContent = value.toFixed(2);
        if (!manual) scrub.value = String(value);
      };

      const fromScroll = () => {
        const max = document.body.scrollHeight - window.innerHeight;
        return max > 0 ? (window.scrollY / max) * 3 : 0;
      };

      scrub.addEventListener("input", () => {
        manual = true;
        toggle.dataset.mode = "manual";
        toggle.textContent = "manual";
        show(Number(scrub.value));
      });

      toggle.addEventListener("click", () => {
        manual = !manual;
        toggle.dataset.mode = manual ? "manual" : "";
        toggle.textContent = manual ? "manual" : "scroll";
        if (!manual) show(fromScroll());
      });

      window.addEventListener("scroll", () => {
        if (!manual) show(fromScroll());
      }, { passive: true });

      window.addEventListener("resize", () => field.resize());

      window.addEventListener("pointermove", (e) => {
        field.setPointer(
          (e.clientX / window.innerWidth) * 2 - 1,
          (e.clientY / window.innerHeight) * 2 - 1
        );
      }, { passive: true });

      let last = performance.now();
      const loop = (now) => {
        field.tick(Math.min((now - last) / 1000, 0.05));
        last = now;
        requestAnimationFrame(loop);
      };

      // Prototype hook: lets a headless run hold any point in the transition.
      window.__lab = { field, show, setManual: (v) => { manual = v; } };

      const params = new URLSearchParams(location.hash.slice(1));

      // `#layout=mark` promotes the monogram to hero subject and recentres it.
      if (params.get("layout") === "mark") {
        document.body.dataset.layout = "mark";
        field.heroOffset.set(0, 0.35);
      }

      // `#p=1.4` pins the progress, so `playwright screenshot` can capture a
      // specific moment without needing to drive the page.
      const pinned = Number(params.get("p"));
      if (Number.isFinite(pinned) && location.hash.includes("p=")) {
        manual = true;
        toggle.dataset.mode = "manual";
        toggle.textContent = "manual";
        scrub.value = String(pinned);
        show(pinned);
      }

      show(manual ? Number(scrub.value) : 0);
      requestAnimationFrame(loop);
    </script>
  </body>
</html>
