---
/**
 * Throwaway prototype — `CW.` as a raymarched volume.
 *
 * Standalone like the other lab pages: no BaseLayout, no ClientRouter, no
 * site.js, so nothing here can reach the live scene. Delete this file plus
 * src/scene/VolumetricFire.js and src/scene/volumetric-fire-shaders.js to
 * remove it.
 */
import "../../styles/main.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Lab — CW. volumetric</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <canvas class="lab-canvas" id="lab-canvas" aria-hidden="true"></canvas>

    <div class="lab-hud">
      <label class="mono" for="scrub">progress</label>
      <input id="scrub" type="range" min="0" max="3" step="0.01" value="0" />
      <output class="mono" id="scrub-out">0.00</output>
      <span class="mono" id="fps">—</span>
      <button class="mono" id="scrub-toggle" type="button">scroll</button>
    </div>

    <main class="lab-main">
      <section class="section section--hero">
        <div class="hero__meta">
          <span class="mono">Based in Taiwan</span>
          <span class="mono">Lab · volumetric</span>
        </div>

        <p class="lab-name mono">Cheng Wei, Wang</p>

        <div class="hero__foot">
          <p class="hero__roles mono">
            Front-End<span class="sep">/</span>Back-End<span class="sep">/</span>Web&nbsp;Game
          </p>
        </div>
      </section>

      <section class="section lab-section">
        <p class="section__label mono">(01) — Volume</p>
        <p class="lab-copy">
          No geometry describes the monogram. One triangle covers the screen and
          every pixel marches a ray through a density field.
        </p>
      </section>

      <section class="section lab-section">
        <p class="section__label mono">(02) — Depth</p>
        <p class="lab-copy">
          Absorption along the ray means flame in front genuinely hides flame
          behind it. Billboards cannot do that at any setting.
        </p>
      </section>

      <section class="section lab-section">
        <p class="section__label mono">(03) — Letting go</p>
        <p class="lab-copy">
          Scroll drags the whole field upward and thins it out.
        </p>
      </section>
    </main>

    <style>
      .lab-canvas {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
      }

      .lab-main {
        position: relative;
        z-index: 1;
      }

      .lab-section {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .lab-copy {
        max-width: 34ch;
        margin-top: 1.5rem;
        font-size: clamp(1rem, 2vw, 1.25rem);
        color: var(--fg-dim);
      }

      .lab-name {
        margin-top: auto;
        color: var(--fg-dim);
      }

      .lab-hud {
        position: fixed;
        left: 50%;
        bottom: 1.5rem;
        transform: translateX(-50%);
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.7rem 1.1rem;
        border: 1px solid var(--line-soft);
        border-radius: 999px;
        background: rgba(10, 10, 13, 0.82);
        backdrop-filter: blur(12px);
      }

      .lab-hud input {
        width: min(40vw, 22rem);
        accent-color: var(--accent);
      }

      .lab-hud output {
        min-width: 3.2em;
        color: var(--accent);
      }

      .lab-hud #fps {
        min-width: 4.5em;
        color: var(--muted);
      }

      .lab-hud button {
        padding: 0.35rem 0.7rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: none;
        color: var(--fg-dim);
        cursor: pointer;
      }

      .lab-hud button[data-mode="manual"] {
        border-color: var(--accent);
        color: var(--accent);
      }
    </style>

    <script>
      import VolumetricFire from "../../scene/VolumetricFire.js";

      const canvas = document.getElementById("lab-canvas");
      const scrub = document.getElementById("scrub");
      const out = document.getElementById("scrub-out");
      const toggle = document.getElementById("scrub-toggle");
      const fpsEl = document.getElementById("fps");

      const field = new VolumetricFire(canvas, { quality: "high" });
      let manual = false;

      const show = (value) => {
        field.setProgress(value);
        out.textContent = value.toFixed(2);
        if (!manual) scrub.value = String(value);
      };

      const fromScroll = () => {
        const max = document.body.scrollHeight - window.innerHeight;
        return max > 0 ? (window.scrollY / max) * 3 : 0;
      };

      scrub.addEventListener("input", () => {
        manual = true;
        toggle.dataset.mode = "manual";
        toggle.textContent = "manual";
        show(Number(scrub.value));
      });

      toggle.addEventListener("click", () => {
        manual = !manual;
        toggle.dataset.mode = manual ? "manual" : "";
        toggle.textContent = manual ? "manual" : "scroll";
        if (!manual) show(fromScroll());
      });

      window.addEventListener("scroll", () => {
        if (!manual) show(fromScroll());
      }, { passive: true });

      window.addEventListener("resize", () => field.resize());

      window.addEventListener("pointermove", (e) => {
        field.setPointer(
          (e.clientX / window.innerWidth) * 2 - 1,
          (e.clientY / window.innerHeight) * 2 - 1
        );
      }, { passive: true });

      const params = new URLSearchParams(location.hash.slice(1));

      // `#fuel=1` draws the solid the flame is shaped from, for comparison.
      if (params.get("fuel") === "1") {
        field.material.uniforms.uFuel.value = 1;
      }

      const pinned = Number(params.get("p"));
      if (Number.isFinite(pinned) && location.hash.includes("p=")) {
        manual = true;
        toggle.dataset.mode = "manual";
        toggle.textContent = "manual";
        scrub.value = String(pinned);
      }

      // Raymarching is expensive enough that the frame cost has to be visible
      // while judging it, not measured afterwards.
      let last = performance.now();
      let frames = 0;
      let acc = 0;

      const loop = (now) => {
        const dt = Math.min((now - last) / 1000, 0.05);
        last = now;

        field.tick(dt);

        acc += dt;
        frames++;
        if (acc >= 0.5) {
          fpsEl.textContent = `${Math.round(frames / acc)} fps`;
          frames = 0;
          acc = 0;
        }

        requestAnimationFrame(loop);
      };

      show(manual ? Number(scrub.value) : 0);
      requestAnimationFrame(loop);
    </script>
  </body>
</html>
