---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import PostRow from "../../components/PostRow.astro";

const posts = (await getCollection("journal", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Journal"
  description="Notes on front-end, back-end and web game development by Cheng Wei, Wang."
>
  <main id="main" data-scene="static" data-scene-stage="1">
    <section class="section section--page">
      <p class="section__label mono" data-fade>Journal</p>

      <div class="parallax-slow">
        <h1 class="page__title" data-reveal>Journal</h1>
      </div>

      {
        posts.length === 0 ? (
          <p class="empty-state">Nothing published yet.</p>
        ) : (
          <ul class="post-list post-list--full" data-stagger>
            {posts.map((post) => (
              <PostRow entry={post} as="h2" showDesc />
            ))}
          </ul>
        )
      }
    </section>
  </main>
</BaseLayout>

<style>
  .post-list--full {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .empty-state {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    color: var(--muted);
  }
</style>
