---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("journal", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const dateFmt = new Intl.DateTimeFormat("en-GB", {
  year: "numeric",
  month: "short",
  day: "2-digit",
});
---

<BaseLayout
  title="Journal"
  description="Notes on front-end, back-end and web game development by Cheng Wei, Wang."
>
  <main id="main" data-scene="static" data-scene-stage="1">
    <section class="section section--page">
      <p class="section__label mono" data-fade>Journal</p>

      <div class="parallax-slow">
        <h1 class="page__title" data-reveal>Journal</h1>
      </div>

      {
        posts.length === 0 ? (
          <p class="empty-state">Nothing published yet.</p>
        ) : (
          <ul class="post-list post-list--full" data-stagger>
            {posts.map((post) => (
              <li class="post-row">
                <a href={`/journal/${post.id}/`}>
                  <time class="mono" datetime={post.data.date.toISOString()}>
                    {dateFmt.format(post.data.date)}
                  </time>
                  <h2 class="post-row__title">{post.data.title}</h2>
                  <span class="arrow" aria-hidden="true">
                    ↗
                  </span>
                  <p class="post-row__desc">{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </main>
</BaseLayout>

<style>
  .post-list--full {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .empty-state {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    color: var(--muted);
  }
</style>
