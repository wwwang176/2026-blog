---
import type { CollectionEntry } from "astro:content";
import { categoryLabel } from "../data/categories";

interface Props {
  entry: CollectionEntry<"works">;
  index: number;
}

const { entry, index } = Astro.props;
const { title, category, overview, year, cover } = entry.data;
const num = String(index + 1).padStart(2, "0");
---

<a class="work-card" href={`/works/${entry.id}/`} data-category={category}>
  <span class="work-card__glow" aria-hidden="true"></span>

  <span class="work-card__index mono">
    <span>({num}) — {categoryLabel(category)}</span>
    {year && <span class="work-card__year">{year}</span>}
  </span>

  {cover && <img class="work-card__thumb" src={cover} alt="" loading="lazy" decoding="async" />}

  <div class="work-card__body">
    <h3 class="work-card__title">{title}</h3>
    <p class="work-card__desc">{overview}</p>
    <span class="work-card__cta mono">
      View project
      <span class="arrow" aria-hidden="true">↗</span>
    </span>
  </div>
</a>
