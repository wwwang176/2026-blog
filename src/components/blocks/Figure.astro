---
interface Props {
  src: string;
  caption?: string;
  alt?: string;
  /** Let the image break out to the full page width. */
  wide?: boolean;
}

const { src, caption, alt = "", wide = false } = Astro.props;
---

<figure class:list={["block", "figure", { "is-wide": wide }]}>
  <img src={src} alt={alt} loading="lazy" decoding="async" />
  {caption && <figcaption class="mono">{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: clamp(3.5rem, 9vw, 6.5rem) 0;
  }

  .figure img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line-soft);
  }

  .figure.is-wide {
    max-width: none;
  }

  figcaption {
    margin-top: 0.9rem;
    color: var(--muted);
  }
</style>
